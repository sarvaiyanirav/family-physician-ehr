{
  "entities": {
    "Patient": {
      "title": "Patient",
      "description": "Comprehensive primary care clinical chart and patient demographic record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique patient identifier",
          "maxLength": 128
        },
        "mrn": {
          "type": "string",
          "description": "Medical Record Number",
          "maxLength": 64
        },
        "firstName": {
          "type": "string",
          "description": "Legal first name",
          "maxLength": 100
        },
        "lastName": {
          "type": "string",
          "description": "Legal last name",
          "maxLength": 100
        },
        "dob": {
          "type": "string",
          "description": "Date of birth in YYYY-MM-DD format",
          "maxLength": 10
        },
        "sex": {
          "type": "string",
          "description": "Biological sex",
          "enum": ["male", "female", "intersex"]
        },
        "healthCardNumber": {
          "type": "string",
          "description": "Provincial or State health insurance identifier",
          "maxLength": 64
        },
        "primaryPhysician": {
          "type": "string",
          "description": "Assigned primary care physician",
          "maxLength": 128
        },
        "clinicLocation": {
          "type": "string",
          "description": "Primary practice location",
          "maxLength": 128
        },
        "codeStatus": {
          "type": "string",
          "description": "Resuscitation preference directive",
          "enum": ["Full Code", "DNR", "DNI", "Limited Intervention"]
        },
        "visitStatus": {
          "type": "string",
          "description": "Current clinic tracking status",
          "enum": ["scheduled_today", "in_exam", "waiting", "completed", "not_scheduled"]
        },
        "triagePriority": {
          "type": "string",
          "description": "Clinical urgency priority",
          "enum": ["emergency", "urgent", "routine"]
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last record update",
          "maxLength": 64
        }
      },
      "required": ["id", "mrn", "firstName", "lastName", "dob", "sex"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Clinical staff user account with role-based authorization",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique user account identifier",
          "maxLength": 128
        },
        "username": {
          "type": "string",
          "description": "Unique username used for login",
          "maxLength": 64
        },
        "displayName": {
          "type": "string",
          "description": "Staff member full legal/professional name",
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "description": "Authorization level within clinic EHR",
          "enum": ["admin", "doctor", "compounder", "lab_technician"]
        },
        "email": {
          "type": "string",
          "description": "Staff email contact",
          "maxLength": 128
        },
        "department": {
          "type": "string",
          "description": "Assigned clinical or operational department",
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "description": "Account status",
          "enum": ["active", "suspended"]
        },
        "createdAt": {
          "type": "string",
          "description": "Account creation ISO timestamp",
          "maxLength": 64
        }
      },
      "required": ["id", "username", "displayName", "role", "status"]
    }
  },
  "firestore": {
    "/patients/{patientId}": {
      "schema": {
        "$ref": "#/entities/Patient"
      },
      "description": "Collection of primary care patient charts"
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserAccount"
      },
      "description": "Collection of application staff users and authorization roles"
    }
  }
}
